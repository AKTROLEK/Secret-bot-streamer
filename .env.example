# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/streamer-management
# OR for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/streamer_management

# Platform API Keys
YOUTUBE_API_KEY=your_youtube_api_key_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TIKTOK_API_KEY=your_tiktok_api_key_here
KICK_API_KEY=your_kick_api_key_here
INSTAGRAM_API_KEY=your_instagram_api_key_here
FACEBOOK_API_KEY=your_facebook_api_key_here

# OpenAI API (for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Dashboard Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Role IDs (Discord)
SOCIAL_MEDIA_MANAGER_ROLE_ID=role_id_here
SOCIAL_TEAM_ROLE_ID=role_id_here
STREAMER_MANAGEMENT_ROLE_ID=role_id_here

# Channel IDs (Discord)
TICKET_CATEGORY_ID=category_id_here
ALERTS_CHANNEL_ID=channel_id_here
REPORTS_CHANNEL_ID=channel_id_here

# System Configuration
NODE_ENV=development
PORT=3000
